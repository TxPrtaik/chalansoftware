<body >
<div class="container-fluid " style="background-image: url(./bg.png) ;height: 100vh;background-size: cover;">
  <div class="row " style="height: 100%;">
    <div class="col-md-8 p-5 d-none d-md-block" style="position: relative;height: 100%;">
    <div class="heading w-100 p-5" style="position: absolute; top: 30%;">
<h1 data-aos="fade-right" data-aos-duration="1000">Transportation That Works for You.</h1>
<p data-aos="fade-right" data-aos-duration="1000">Connecting businesses, powering growth.</p>
    </div>

  </div>
<div class="col-md-4  signin p-5 text-center"  style="position: relative;">
<h1 class="text-light" data-aos="fade-down" data-aos-duration="1000" style="font-size: 40px;text-transform: uppercase;font-weight: bolder;letter-spacing: 2px;">Login</h1>
<div class="row mt-5" data-aos="fade-down" data-aos-duration="1000">
  <div class="col-md-12 mb-3 mt-5 text-start">
    <form method="post" action="/user-login">

  
    <label for="username" class="mb-2 text-light">Username : </label>
    <input class="my-inp shadow" name="username" placeholder="Username*" required/>
  </div>
   <div class="col-md-12 mb-3 text-start">
    <label for="username" class="mb-2 text-light">Password : </label>
    <input class="my-inp shadow" name="password" type="password" placeholder="Password*" required/>

  
  </div>
  <div class="col-md-12">
    <button style="background-color: orange;" class="btn shadow  w-100 mt-4 p-3 fs-5 fw-bold text-light ">Login</button>
      </form>
  </div>
</div>
</div>
</div>
</div>

