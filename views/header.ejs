    <link rel="icon" href="/icon.jpeg"/>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <style>
        :root {
            --sidebar-width: 250px;
            --sidebar-bg: #2c3e50;
            --sidebar-color: #ecf0f1;
            --primary-color: #3498db;
            --secondary-color: #2c3e50;
            --accent-color: #e74c3c;
        }
        
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f8f9fa;
            overflow-x: hidden;
        }
        
        #sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            position: fixed;
            left: 0;
            top: 0;
            background: var(--sidebar-bg);
            color: var(--sidebar-color);
            transition: all 0.3s;
            z-index: 1000;
            padding-top: 56px;
        }
        
        #sidebar.collapsed {
            margin-left: calc(var(--sidebar-width) * -1);
        }
        
        #content {
            margin-left: var(--sidebar-width);
            transition: all 0.3s;
            min-height: 100vh;
            padding-top: 56px;
        }
        
        #content.expanded {
            margin-left: 0;
        }
        
        .sidebar-header {
            padding: 20px;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }
        
        .sidebar-menu {
            padding: 0;
            list-style: none;
        }
        
        .sidebar-menu li {
            position: relative;
        }
        
        .sidebar-menu li a {
            color: var(--sidebar-color);
            text-decoration: none;
            display: block;
            padding: 12px 20px;
            transition: all 0.3s;
        }
        
        .sidebar-menu li a:hover, 
        .sidebar-menu li a.active {
            background-color: rgba(255,255,255,0.1);
            color: #fff;
        }
        
        .sidebar-menu .dropdown-menu {
            background-color: rgba(0,0,0,0.2);
            border: none;
            border-radius: 0;
            padding: 0;
        }
        
        .sidebar-menu .dropdown-item {
            color: var(--sidebar-color);
            padding: 10px 15px 10px 35px;
        }
        
        .sidebar-menu .dropdown-item:hover {
            background-color: rgba(255,255,255,0.1);
            color: #fff;
        }
        
        .sidebar-menu .dropdown-toggle::after {
            position: absolute;
            right: 20px;
            top: 50%;
            transform: translateY(-50%);
        }
        
        .nav-icon {
            width: 20px;
            margin-right: 10px;
            text-align: center;
        }
        
        .card-dashboard {
            border-radius: 10px;
            border: none;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            transition: transform 0.3s;
        }
        
        .card-dashboard:hover {
            transform: translateY(-5px);
        }
        
        .card-icon {
            font-size: 2rem;
            margin-bottom: 15px;
        }
        
        .stats-number {
            font-size: 1.8rem;
            font-weight: bold;
        }
        
        .stats-title {
            color: #6c757d;
            font-size: 0.9rem;
        }
        
        .custom-toggler {
            border: none;
            color: #6c757d;
        }
        
        @media (max-width: 768px) {
            #sidebar {
                margin-left: calc(var(--sidebar-width) * -1);
            }
            
            #sidebar.mobile-show {
                margin-left: 0;
            }
            
            #content {
                margin-left: 0;
            }
            
            #content.mobile-expanded {
                margin-left: 0;
            }
            
            .overlay {
                display: none;
                position: fixed;
                width: 100vw;
                height: 100vh;
                background: rgba(0, 0, 0, 0.7);
                z-index: 999;
                opacity: 0;
                transition: all 0.5s ease-in-out;
            }
            
            .overlay.active {
                display: block;
                opacity: 1;
            }
        }
        @media (max-width:610px) {
             .cr{
                text-align: center;
                font-size: 13px;
             }
        }
    </style>
</head>
