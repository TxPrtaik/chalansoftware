<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Chalan Invoice</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { background-color: #f8f9fa; }
    .invoice-box {
      background: #fff;
      padding: 30px;
      border-radius: 12px;
      box-shadow: 0 0 12px rgba(0,0,0,0.15);
      max-width: 900px;
      margin: auto;
    }
    .invoice-header {
      border-bottom: 2px solid #0d6efd;
      margin-bottom: 20px;
      padding-bottom: 10px;
    }
    .invoice-title {
      font-size: 24px;
      font-weight: bold;
      color: #0d6efd;
    }
    .table th {
      background-color: #e9ecef;
    }
    .print-btn {
      margin-top: 20px;
    }
    @media print {
      .print-btn { display: none; }
    }
  </style>
</head>
<body>
<%
function numberToWords(num) {
  // Remove commas if input is string
  if (typeof num === "string") {
    num = num.replace(/,/g, '');
  }
  num = Number(num);
  if (isNaN(num)) return "Invalid number";

  const ones = ["", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine",
    "ten", "eleven", "twelve", "thirteen", "fourteen", "fifteen", 
    "sixteen", "seventeen", "eighteen", "nineteen"];
  const tens = ["", "", "twenty", "thirty", "forty", "fifty", 
    "sixty", "seventy", "eighty", "ninety"];

  function helper(n) {
    let str = "";
    if (n < 20) str = ones[n];
    else if (n < 100) str = tens[Math.floor(n / 10)] + (n % 10 !== 0 ? " " + ones[n % 10] : "");
    else if (n < 1000) str = ones[Math.floor(n / 100)] + " hundred" + (n % 100 !== 0 ? " " + helper(n % 100) : "");
    return str;
  }

  function convertIntegerPart(n) {
    let result = "";
    const crore = Math.floor(n / 10000000);
    const lakh = Math.floor((n % 10000000) / 100000);
    const thousand = Math.floor((n % 100000) / 1000);
    const hundred = Math.floor(n % 1000);

    if (crore) result += helper(crore) + " crore ";
    if (lakh) result += helper(lakh) + " lakh ";
    if (thousand) result += helper(thousand) + " thousand ";
    if (hundred) result += helper(hundred);

    return result.trim();
  }

  const integerPart = Math.floor(num);
  const decimalPart = Math.round((num - integerPart) * 100); // get 2 decimal digits

  let words = convertIntegerPart(integerPart) + " rupees";
  if (decimalPart > 0) {
    words += " and " + convertIntegerPart(decimalPart) + " paise";
  }

  return words;
}


%>
<div class="invoice-box">
  <!-- Header -->
  <div class="row invoice-header">
    <div class="col-8">
      <img src="/Logo.png" alt="logo"  height="110" width="150" /><br>
      गट क्र. १२७, पंतजलि पार्क, नेवासा फाटा रोड, एस.आर. मॅजिस्ट्रेट्स कोर्ट, कोर्ट मागे, नेवासा, अहिल्यानगर, अहमदनगर, महाराष्ट्र – ४१४६०३
      
    </div>
    <div class="col-4 text-end">
      <h6>वाहतूक चलन</h6>
      <p class="mb-0">दिनांक: <strong><%-det.invoiceDate%></strong></p>
      <p class="mb-0">बिल नं: <strong>C-<%-new Date().getFullYear()+"-"+det.id%></strong></p>
    </div>
  </div>

  <!-- Receiver Info -->
  <div class="row mb-3">
    <div class="col-md-6">
      <p><strong>मेसेर्स:</strong> <%-det.receiverName%></p>
      
      <p><strong>Receiver Mobile:</strong> <%-det.receiverMobile%></p>
    </div>
    <div class="col-md-6 text-md-end">
      <p><strong>गाडी नं:</strong> <%-det.vehicleNo%></p>
    </div>
  </div>

  <!-- Table -->
  <table class="table table-bordered text-center align-middle">
    <thead>
      <tr>
        <th>Sr. No</th>
        <th>मालाचा तपशील</th>
        
        <th>युनिट्स</th>
        <th>दर</th>
        <th>रक्कम</th>
      </tr>
    </thead>
    <tbody>
      <%for(let i=0;i<pro.length;i++){%>
        
        <tr>
        <td><%-i+1%></td>
        <td><%-pro[i].product%></td>
        <td><%-pro[i].qty%></td>
        <td>&#8377; <%-pro[i].rate%></td>
        <td>&#8377; <%-pro[i].amount%></td>
      </tr>
        
        <%}%>
      
    </tbody>
  </table>

  <!-- Bottom Details -->
  <div class="row mt-4">
    <div class="col-md-12">
      <table class="table table-bordered">
        <tbody>
            <tr>
            <th>Total Amount </th>
            <td>&#8377; <%-det.total%> /-</td>
          </tr>
          <tr>
            <th>Total Amount (in words)</th>
            <td style="text-transform: capitalize;"><%-numberToWords(det.total)%> only</td>
          </tr>
         
        </tbody>
      </table>
    </div>
  </div>

  <!-- Signature -->
  <div class="row mt-4">
    <div class="col-6">
      <p><strong>नाथसागर ट्रेडिंग, नेवासा</strong></p>
    </div>
    <div class="col-6 text-end">
     
       <p><strong> स्वीकर्त्याची स्वाक्षरी</strong></p>
      
     
    </div>
  </div>

  <!-- Print Button -->
  <div class="text-center print-btn">
    <button class="btn btn-primary" onclick="window.print()">🖨️ Print Invoice</button>
  </div>
</div>
<script>
  
</script>
</body>
</html>
