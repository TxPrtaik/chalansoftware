<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Chalan Invoice</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { background-color: #f8f9fa; }
    .invoice-box {
      background: #fff;
      padding: 30px;
      border-radius: 12px;
      box-shadow: 0 0 12px rgba(0,0,0,0.15);
      max-width: 900px;
      margin: auto;
    }
    .invoice-header {
      border-bottom: 2px solid #0d6efd;
      margin-bottom: 20px;
      padding-bottom: 10px;
    }
    .invoice-title {
      font-size: 24px;
      font-weight: bold;
      color: #0d6efd;
    }
    .table th {
      background-color: #e9ecef;
    }
    .print-btn {
      margin-top: 20px;
    }
    @media print {
      .print-btn { display: none; }
    }
  </style>
</head>
<body>

<div class="invoice-box">
  <!-- Header -->
  <div class="row invoice-header">
    <div class="col-8">
      <h2 class="invoice-title">हेमंत कॉर्पोरेशन</h2>
      <p class="mb-0">टेके वाडा, म.पो. अकुर्ड - 413309 ता.माळशिरस, जि. सोलापूर</p>
      <p class="mb-0">Mob: 7028282304, GST NO: 27ABXPT6868K1Z6</p>
    </div>
    <div class="col-4 text-end">
      <h6>वाहतूक चलन</h6>
      <p class="mb-0">दिनांक: <strong>17.08.2025</strong></p>
      <p class="mb-0">बिल नं: <strong>854</strong></p>
    </div>
  </div>

  <!-- Receiver Info -->
  <div class="row mb-3">
    <div class="col-md-6">
      <p><strong>मेसेर्स:</strong> Nath Sagar Trading Nevasa</p>
      <p><strong>Receiver Name:</strong> ___________</p>
      <p><strong>Receiver Mobile:</strong> ___________</p>
    </div>
    <div class="col-md-6 text-md-end">
      <p><strong>गाडी नं:</strong> MH45 AF 2547</p>
    </div>
  </div>

  <!-- Table -->
  <table class="table table-bordered text-center align-middle">
    <thead>
      <tr>
        <th>Sr. No</th>
        <th>मालाचा तपशील</th>
        <th>युनिट्स</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>1</td>
        <td>Whey Powder Amul (600-130)</td>
        <td>65 Bag</td>
      </tr>
    </tbody>
  </table>

  <!-- Bottom Details -->
  <div class="row mt-4">
    <div class="col-md-12">
      <table class="table table-bordered">
        <tbody>
          <tr>
            <th>Tax Amount (in words)</th>
            <td>Indian Rupees Thirteen Thousand Six Hundred Nineteen Only</td>
          </tr>
          <tr>
            <th>Company’s PAN</th>
            <td>ABXPT6868K</td>
          </tr>
          <tr>
            <th>Bank Details</th>
            <td>
              <strong>Bank Name:</strong> Bank of India <br>
              <strong>Account No:</strong> 1234567890 <br>
              <strong>Branch & IFSC:</strong> Solapur Branch, BKID0001234
            </td>
          </tr>
          <tr>
            <th>Declaration</th>
            <td>
              I/We hereby certify that my/our registration certificate under the Maharashtra Value Added Tax Act 2002 is valid, and the transaction covered by this invoice has been effected by us.
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Signature -->
  <div class="row mt-4">
    <div class="col-6">
      <p><strong>Receiver’s Signature</strong></p>
    </div>
    <div class="col-6 text-end">
      <p><strong>For Hemant Corporation</strong></p>
      <p>Authorized Signatory</p>
    </div>
  </div>

  <!-- Print Button -->
  <div class="text-center print-btn">
    <button class="btn btn-primary" onclick="window.print()">🖨️ Print Invoice</button>
  </div>
</div>

</body>
</html>
