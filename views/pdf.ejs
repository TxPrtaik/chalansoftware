<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Quotation PDF</title>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.25/jspdf.plugin.autotable.min.js"></script>
</head>
<body>
  <button id="download">📄 Download Quotation PDF</button>

  <script>
    document.getElementById("download").onclick = function () {
      const { jsPDF } = window.jspdf;
      const doc = new jsPDF();

      let y = 20;
      doc.setFontSize(18);
      doc.text("Quotation", 105, y, { align: "center" });

      y += 10;
      doc.setFontSize(12);
      doc.text("To: Nath Sagar Trading Company", 14, y); y += 6;
      doc.text("Date: 27th September 2025", 14, y); y += 6;
      doc.text("Prepared By: Pratik Chindhe", 14, y); y += 6;
      doc.text("Contact: 7058451982", 14, y); y += 10;

      doc.setFontSize(14);
      doc.text("Project Overview", 14, y); y += 6;
      doc.setFontSize(12);
      const overview = [
        "A Chalan / Invoice Management System built using Node.js and MySQL.",
        "Features include:",
        "- Add new chalans/invoices with dynamic product entries and tax calculation (CGST + SGST)",
        "- View history of previous chalans",
        "- Search/filter chalans by invoice number, date, or receiver",
        "- Delete chalans if needed",
        "Live Demo: https://chalansoftware.onrender.com"
      ];
      overview.forEach(line => { doc.text(line, 14, y); y += 6; });
      y += 4;

      doc.setFontSize(14);
      doc.text("Scope of Work / Features", 14, y); y += 6;
      doc.setFontSize(12);

      // Features table
      doc.autoTable({
        startY: y,
        head: [['Feature', 'Complexity', 'Description']],
        body: [
          ["Add Chalan / Invoice", "Medium", "Add multiple products, calculate taxes automatically"],
          ["Chalan / Invoice History", "Medium", "View previous chalans in tabular format"],
          ["Search / Filter", "Medium", "Search by invoice number, date, receiver"],
          ["Delete Chalan", "Low", "Delete existing chalan from database"],
          ["Responsive UI", "Low", "Works on desktop and mobile"]
        ],
        theme: 'grid',
        headStyles: { fillColor: [41, 128, 185], textColor: 255 },
        styles: { fontSize: 11 }
      });

      y = doc.lastAutoTable.finalY + 10;
      doc.setFontSize(14);
      doc.text("Project Complexity & Pricing", 14, y); y += 6;
      doc.setFontSize(12);
      doc.text("Final Price: 5,000 Rs", 14, y); y += 6;
      doc.text("Payment Terms: Full payment before deployment", 14, y); y += 10;

      doc.setFontSize(14);
      doc.text("Validity", 14, y); y += 6;
      doc.setFontSize(12);
      doc.text("This quotation is valid for 30 days from the date of issue.", 14, y);

      doc.save("Quotation_NathSagarTrading.pdf");
    };
  </script>
</body>
</html>
